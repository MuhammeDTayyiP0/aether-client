#!/bin/sh
HERE="$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")"
CONF="${AETHER_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/aether/config.json}"
if [ ! -f "$CONF" ]; then
  echo "config yok: $CONF" >&2
  echo "Aether panel -> Atolye -> sing-box.json buraya." >&2
  exit 1
fi
exec "$HERE/usr/bin/aether-core" run -c "$CONF"
